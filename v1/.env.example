# docker-compose.yml용 환경변수 예시 - 실제 값은 .env로 복사해서 채운다(.env는 git에 올리지 않음)

# 호스트에 노출할 포트 - prd는 38080, dev/staging 용도로 띄울 땐 48080
API_PORT=38080

# apm-api가 사용할 Spring 프로파일
SPRING_PROFILES_ACTIVE=prd

# MySQL 접속 정보 - MySQL 자체는 이 저장소가 관리하지 않고, 호스트에
# localhost:${DB_PORT}로 이미 떠 있다고 가정한다(prd=33306, dev=43306)
DB_PORT=33306
DB_NAME=apm
DB_USER=apm
DB_PASSWORD=changeme

# 알림 외부 소스(선택) - apm_alert 라벨이 붙은 Jira 이슈 / Todoist 태스크를 알림으로 가져온다.
# 비워 두면 해당 소스는 비활성(SKIPPED)이고 기동에는 영향이 없다.
ALERT_JIRA_BASE_URL=
ALERT_JIRA_EMAIL=
ALERT_JIRA_API_TOKEN=
ALERT_TODOIST_API_TOKEN=
